LIFEOPS_DB_PATH=lifeops.sqlite3
LOG_LEVEL=INFO

LIFEOPS_LLM_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

WEATHER_PROVIDER=openmeteo
OPENWEATHER_API_KEY=

PLACE_PROVIDER=osm
AMAP_API_KEY=

SEARCH_PROVIDER=auto
# auto: SearchFree -> DuckDuckGo -> Wikimedia，不会自动优先使用博查。
# 国内免 key 可设为 searchfree；需要博查时显式设 SEARCH_PROVIDER=bocha。
BOCHA_API_KEY=
SEARCH_FRESHNESS=noLimit
SEARCH_SUMMARY=true
SEARCH_COUNT=8
SEARCH_INCLUDE=
SEARCH_EXCLUDE=

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://192.168.0.107:5174,http://192.168.195.1:5174,http://192.168.10.1:5174
